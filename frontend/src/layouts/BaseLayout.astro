---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCategories } from "../lib/solutions";

const { title, description } = Astro.props as { title?: string; description?: string };
const categories = getCategories();
const pageTitle = title ? `${title} · System Design Atlas` : "System Design Atlas";
const pageDescription =
  description ??
  "System Design Atlas: a collection of system design solutions with diagrams, trade-offs, and simplification notes.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark =
            window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          const theme = stored || (prefersDark ? "dark" : "light");
          document.documentElement.classList.toggle("dark", theme === "dark");
        } catch {}
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 rounded bg-sda-bg px-3 py-2 ring-1 ring-sda-border">
      Skip to content
    </a>
    <Header categories={categories} />
    <main id="content" class="mx-auto max-w-6xl px-4 py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>

