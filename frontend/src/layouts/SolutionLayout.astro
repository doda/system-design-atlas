---
import BaseLayout from "./BaseLayout.astro";
import DifficultyBadge from "../components/DifficultyBadge.astro";
import CategoryLabel from "../components/CategoryLabel.astro";
import TagList from "../components/TagList.astro";
import TableOfContents from "../components/TableOfContents.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import PipelineStageSelector from "../components/PipelineStageSelector.astro";
import type { Solution, PipelineStage } from "../lib/solutions";
import { categoryUrl, solutionUrl } from "../lib/solutions";

const {
  solution,
  headings,
  prev,
  next,
  currentStage = "final",
  hasDraft = false,
  hasReviewed = false,
  hasFinal = true,
} = Astro.props as {
  solution: Solution;
  headings: Array<{ depth: number; slug: string; text: string }>;
  prev?: Solution;
  next?: Solution;
  currentStage?: PipelineStage;
  hasDraft?: boolean;
  hasReviewed?: boolean;
  hasFinal?: boolean;
};
---

<BaseLayout title={solution.title} description={`${solution.title} — ${solution.categoryLabel} (${solution.difficulty})`}>
  <div class="mb-8 flex flex-col gap-3">
    <nav class="text-sm text-sda-fg-muted" aria-label="Breadcrumb">
      <a class="hover:text-sda-fg" href="/">Home</a>
      <span aria-hidden="true"> / </span>
      <a class="hover:text-sda-fg" href={categoryUrl(solution.categorySlug)}>{solution.categoryLabel}</a>
    </nav>

    <h1 class="text-3xl font-semibold tracking-tight">{solution.title}</h1>

    <div class="flex flex-wrap items-center gap-2">
      <DifficultyBadge difficulty={solution.difficulty} />
      <CategoryLabel label={solution.categoryLabel} />
      {solution.generationTimeSeconds && (
        <span class="inline-flex items-center gap-1 rounded-full bg-sda-bg-subtle px-2.5 py-0.5 text-xs font-medium text-sda-fg-muted" title="Model thinking time">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {Math.floor(solution.generationTimeSeconds / 60)}m {solution.generationTimeSeconds % 60}s
        </span>
      )}
      <TagList tags={solution.tags} />
    </div>
  </div>

  {(hasDraft || hasReviewed || hasFinal) && (hasDraft || hasReviewed) ? (
    <PipelineStageSelector
      slug={solution.slug}
      categorySlug={solution.categorySlug}
      currentStage={currentStage}
      hasDraft={hasDraft}
      hasReviewed={hasReviewed}
      hasFinal={hasFinal}
    />
  ) : null}

  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr),260px]">
    <article class="prose prose-slate max-w-none dark:prose-invert prose-headings:scroll-mt-24 prose-pre:bg-transparent prose-pre:p-0 prose-code:before:content-none prose-code:after:content-none">
      <slot />
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-24">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>

  <div class="mt-12 flex flex-col gap-3 border-t border-sda-border pt-8 sm:flex-row sm:items-center sm:justify-between">
    {prev ? (
      <a class="rounded-lg border border-sda-border bg-sda-bg px-4 py-3 text-sm hover:border-sda-brand/50" href={solutionUrl(prev)}>
        <div class="text-xs uppercase tracking-wide text-sda-fg-muted">Previous</div>
        <div class="font-medium">{prev.title}</div>
      </a>
    ) : (
      <div />
    )}
    {next ? (
      <a class="rounded-lg border border-sda-border bg-sda-bg px-4 py-3 text-sm hover:border-sda-brand/50 text-right" href={solutionUrl(next)}>
        <div class="text-xs uppercase tracking-wide text-sda-fg-muted">Next</div>
        <div class="font-medium">{next.title}</div>
      </a>
    ) : (
      <div />
    )}
  </div>

  <MermaidDiagram />
</BaseLayout>

