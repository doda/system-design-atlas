---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllSolutions, getCategories, solutionUrl, categoryUrl } from "../lib/solutions";

const solutions = getAllSolutions();
const categories = getCategories();

// Group solutions by category, maintaining category order
const solutionsByCategory = new Map<string, typeof solutions>();
for (const cat of categories) {
  solutionsByCategory.set(cat.slug, solutions.filter(s => s.categorySlug === cat.slug));
}

// Roman numerals for chapter numbers
const romanNumerals = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
---

<BaseLayout>
  <div class="max-w-3xl mx-auto">
    <!-- Title Page -->
    <header class="text-center mb-16 pt-8">
      <p class="font-serif text-sm tracking-[0.3em] uppercase text-sda-fg-muted mb-4">A Comprehensive Guide to</p>
      <h1 class="font-serif text-5xl sm:text-6xl font-medium tracking-tight mb-4">
        System Design
      </h1>
      <div class="w-24 h-px bg-sda-fg-muted mx-auto mb-4"></div>
      <p class="font-serif text-2xl sm:text-3xl italic text-sda-fg-muted">Atlas</p>
      <p class="mt-8 font-serif text-base text-sda-fg-muted max-w-md mx-auto leading-relaxed">
        {solutions.length} solutions with diagrams, trade-offs, and simplification notes
      </p>
    </header>

    <!-- Decorative divider -->
    <div class="flex items-center justify-center gap-4 mb-12">
      <div class="h-px flex-1 bg-sda-border"></div>
      <span class="font-serif text-sda-fg-muted text-lg">❧</span>
      <div class="h-px flex-1 bg-sda-border"></div>
    </div>

    <!-- Table of Contents -->
    <nav class="mb-16">
      <h2 class="font-serif text-center text-lg tracking-[0.2em] uppercase text-sda-fg-muted mb-10">
        Contents
      </h2>

      <ol class="space-y-10">
        {categories.map((category, i) => {
          const categorySolutions = solutionsByCategory.get(category.slug) || [];
          if (categorySolutions.length === 0) return null;

          return (
            <li>
              <!-- Chapter heading -->
              <div class="mb-4">
                <a href={categoryUrl(category.slug)} class="group block">
                  <div class="flex items-baseline gap-4">
                    <span class="font-serif text-sm text-sda-fg-muted tracking-wider">
                      {romanNumerals[i] || i + 1}
                    </span>
                    <h3 class="font-serif text-xl font-medium group-hover:text-sda-brand transition-colors">
                      {category.label}
                    </h3>
                  </div>
                </a>
              </div>

              <!-- Solution entries -->
              <ul class="space-y-1 pl-8 border-l border-sda-border/50">
                {categorySolutions.map((solution, j) => (
                  <li>
                    <a
                      href={solutionUrl(solution)}
                      class="group flex items-baseline gap-2 py-1.5 hover:bg-sda-bg-subtle -mx-2 px-2 rounded transition-colors"
                    >
                      <span class="font-serif text-base group-hover:text-sda-brand transition-colors">
                        {solution.title}
                      </span>
                      <span class="flex-1 border-b border-dotted border-sda-border/60 min-w-[2rem] translate-y-[-0.3em]"></span>
                      <span class="font-mono text-xs text-sda-fg-muted tabular-nums">
                        {String(j + 1).padStart(2, '0')}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })}
      </ol>
    </nav>

    <!-- Decorative footer -->
    <div class="flex items-center justify-center gap-4 mb-8">
      <div class="h-px flex-1 bg-sda-border"></div>
      <span class="font-serif text-sda-fg-muted text-lg">✦</span>
      <div class="h-px flex-1 bg-sda-border"></div>
    </div>

    <!-- Colophon -->
    <footer class="text-center font-serif text-sm text-sda-fg-muted pb-8">
      <p class="italic">Generated with care by machines, curated by humans</p>
    </footer>
  </div>
</BaseLayout>
