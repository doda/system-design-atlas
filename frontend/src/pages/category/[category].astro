---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SolutionCard from "../../components/SolutionCard.astro";
import { getCategories, getSolutionsByCategory } from "../../lib/solutions";

export async function getStaticPaths() {
  return getCategories().map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const categories = getCategories();
const current = categories.find((c) => c.slug === category);
const solutions = getSolutionsByCategory(category);
---

<BaseLayout title={current?.label ?? "Category"}>
  <div class="mb-10">
    <nav class="text-sm text-sda-fg-muted" aria-label="Breadcrumb">
      <a class="hover:text-sda-fg" href="/">Home</a>
      <span aria-hidden="true"> / </span>
      <span class="text-sda-fg">{current?.label ?? category}</span>
    </nav>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">{current?.label ?? category}</h1>
    <p class="mt-2 text-sda-fg-muted">{solutions.length} solutions</p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {solutions.map((solution) => (
      <SolutionCard solution={solution} />
    ))}
  </div>
</BaseLayout>

