---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found">
  <h1 class="text-3xl font-semibold tracking-tight">Page not found</h1>
  <p class="mt-3 text-sda-fg-muted">The page you’re looking for doesn’t exist.</p>
  <a class="mt-6 inline-flex rounded-lg border border-sda-border bg-sda-bg px-4 py-2 text-sm hover:border-sda-brand/50" href="/">
    Back to home
  </a>
</BaseLayout>

