---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBox from "../components/Search.astro";
---

<BaseLayout title="Search">
  <div class="mb-8 flex flex-col gap-3">
    <h1 class="text-3xl font-semibold tracking-tight">Search</h1>
    <p class="max-w-2xl text-sda-fg-muted">
      Full-text search across titles, tags, and solution content (client-side).
    </p>
    <SearchBox initialQuery={Astro.url.searchParams.get("q") ?? ""} />
  </div>

  <div id="search-status" class="text-sm text-sda-fg-muted"></div>
  <div id="search-results" class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>

  <noscript>
    <p class="mt-6 rounded-lg border border-sda-border bg-sda-bg-subtle p-4 text-sm text-sda-fg-muted">
      Search needs JavaScript. Reading individual solutions works without it.
    </p>
  </noscript>

  <script is:inline>
    (() => {
      const input = document.getElementById("q");
      const status = document.getElementById("search-status");
      const results = document.getElementById("search-results");
      if (!input || !status || !results) return;

      let index = null;
      const normalize = (s) => (s || "").toLowerCase();
      const escapeHtml = (s) =>
        String(s)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

      const score = (item, q) => {
        const t = normalize(item.title);
        const c = normalize(item.category);
        const tags = normalize((item.tags || []).join(" "));
        const body = normalize(item.text);
        let s = 0;
        if (t.includes(q)) s += 8;
        if (tags.includes(q)) s += 5;
        if (c.includes(q)) s += 2;
        if (body.includes(q)) s += 1;
        return s;
      };

      const render = (q) => {
        const query = normalize(q).trim();
        if (!index) return;
        if (!query) {
          status.textContent = `Type to search ${index.items.length} solutions.`;
          results.innerHTML = "";
          return;
        }

        const matches = index.items
          .map((item) => ({ item, s: score(item, query) }))
          .filter((x) => x.s > 0)
          .sort((a, b) => b.s - a.s)
          .slice(0, 50)
          .map((x) => x.item);

        status.textContent = `Found ${matches.length} result${matches.length === 1 ? "" : "s"} for “${q}”.`;
        results.innerHTML = matches
          .map(
            (m) => `
              <a href="${m.url}" class="block rounded-xl border border-sda-border bg-sda-bg p-5 shadow-soft hover:-translate-y-0.5 hover:border-sda-brand/50 transition">
                <div class="flex items-start justify-between gap-4">
                  <div class="text-base font-semibold tracking-tight">${escapeHtml(m.title)}</div>
                  <div class="text-xs text-sda-fg-muted">${escapeHtml(m.difficulty)}</div>
                </div>
                <div class="mt-2 text-xs text-sda-fg-muted">${escapeHtml(m.category)}</div>
              </a>
            `,
          )
          .join("");
      };

      const boot = async () => {
        status.textContent = "Loading search index…";
        const res = await fetch("/search.json");
        index = await res.json();
        status.textContent = `Type to search ${index.items.length} solutions.`;
        render(input.value);
      };

      input.addEventListener("input", (e) => render(e.target.value));
      boot().catch(() => {
        status.textContent = "Failed to load search index.";
      });
    })();
  </script>
</BaseLayout>
