---
import Search from "./Search.astro";

const {
  categories,
} = Astro.props as {
  categories: Array<{ label: string; slug: string; count: number }>;
};
---

<header class="border-b border-sda-border bg-sda-bg/80 backdrop-blur supports-[backdrop-filter]:bg-sda-bg/60">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
    <div class="flex items-center gap-4">
      <a href="/" class="inline-flex items-center gap-2 font-semibold tracking-tight">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-sda-bg-subtle ring-1 ring-inset ring-sda-border">SA</span>
        <span class="hidden sm:inline">System Design Atlas</span>
      </a>
      <nav class="hidden lg:flex items-center gap-2" aria-label="Categories">
        {categories.slice(0, 6).map((c) => (
          <a
            href={`/category/${c.slug}`}
            class="rounded-md px-2 py-1 text-sm text-sda-fg-muted hover:text-sda-fg hover:bg-sda-bg-subtle focus:outline-none focus-visible:ring-2 focus-visible:ring-sda-brand/60"
          >
            {c.label}
          </a>
        ))}
        {categories.length > 6 ? (
          <a
            href="/"
            class="rounded-md px-2 py-1 text-sm text-sda-fg-muted hover:text-sda-fg hover:bg-sda-bg-subtle focus:outline-none focus-visible:ring-2 focus-visible:ring-sda-brand/60"
          >
            All
          </a>
        ) : null}
      </nav>
    </div>

    <div class="hidden md:block">
      <Search />
    </div>

    <div class="flex items-center gap-2">
      <a
        href="/search"
        class="md:hidden rounded-md px-3 py-2 text-sm font-medium text-sda-fg-muted hover:text-sda-fg hover:bg-sda-bg-subtle focus:outline-none focus-visible:ring-2 focus-visible:ring-sda-brand/60"
      >
        Search
      </a>
      <button
        type="button"
        id="theme-toggle"
        class="rounded-md px-3 py-2 text-sm font-medium text-sda-fg-muted hover:text-sda-fg hover:bg-sda-bg-subtle focus:outline-none focus-visible:ring-2 focus-visible:ring-sda-brand/60"
        aria-label="Toggle dark mode"
      >
        Theme
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;

    const getPreferred = () =>
      window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

    const getTheme = () => localStorage.getItem("theme") || getPreferred();
    const setTheme = (t) => {
      localStorage.setItem("theme", t);
      document.documentElement.classList.toggle("dark", t === "dark");
    };

    btn.addEventListener("click", () => setTheme(getTheme() === "dark" ? "light" : "dark"));
  })();
</script>

