---
const { initialQuery = "" } = Astro.props as { initialQuery?: string };
---

<form action="/search" method="get" class="w-full max-w-md">
  <label class="sr-only" for="q">Search solutions</label>
  <div class="relative">
    <input
      id="q"
      name="q"
      value={initialQuery}
      placeholder="Search (title, tags, content)…"
      class="w-full rounded-lg border border-sda-border bg-sda-bg px-3 py-2 pr-10 text-sm text-sda-fg placeholder:text-sda-fg-muted shadow-soft focus:outline-none focus-visible:ring-2 focus-visible:ring-sda-brand/60"
      autocomplete="off"
    />
    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-sda-fg-muted">
      <span aria-hidden="true">⌘K</span>
    </div>
  </div>
</form>

<script is:inline>
  (() => {
    const input = document.getElementById("q");
    if (!input) return;
    window.addEventListener("keydown", (e) => {
      const isMac = navigator.platform.toLowerCase().includes("mac");
      const hotkey = isMac ? e.metaKey && e.key.toLowerCase() === "k" : e.ctrlKey && e.key.toLowerCase() === "k";
      if (!hotkey) return;
      e.preventDefault();
      input.focus();
    });
  })();
</script>

