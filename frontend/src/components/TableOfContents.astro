---
type Heading = { depth: number; slug: string; text: string };
const { headings } = Astro.props as { headings: Heading[] };

const filtered = (headings ?? []).filter((h) => h.depth >= 2 && h.depth <= 4);
---

{filtered.length ? (
  <nav aria-label="On this page" class="text-sm">
    <div class="mb-3 text-xs font-semibold uppercase tracking-wide text-sda-fg-muted">On this page</div>
    <ol class="space-y-2">
      {filtered.map((h) => (
        <li class={h.depth === 2 ? "" : h.depth === 3 ? "pl-3" : "pl-6"}>
          <a
            href={`#${h.slug}`}
            class="block rounded-md px-2 py-1 text-sda-fg-muted hover:text-sda-fg hover:bg-sda-bg-subtle focus:outline-none focus-visible:ring-2 focus-visible:ring-sda-brand/60"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
) : null}

