---
const { difficulty } = Astro.props as { difficulty: string };

const tone =
  difficulty.toLowerCase() === "easy"
    ? "bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 ring-emerald-500/20"
    : difficulty.toLowerCase() === "medium"
      ? "bg-amber-500/15 text-amber-700 dark:text-amber-300 ring-amber-500/20"
      : difficulty.toLowerCase() === "hard"
        ? "bg-rose-500/15 text-rose-700 dark:text-rose-300 ring-rose-500/20"
        : "bg-slate-500/15 text-slate-700 dark:text-slate-300 ring-slate-500/20";
---

<span class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${tone}`}>
  <span class="sr-only">Difficulty:</span>
  {difficulty}
</span>

