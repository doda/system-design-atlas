---
import DifficultyBadge from "./DifficultyBadge.astro";
import CategoryLabel from "./CategoryLabel.astro";
import TagList from "./TagList.astro";
import type { Solution } from "../lib/solutions";
import { solutionUrl, categoryUrl } from "../lib/solutions";

const { solution } = Astro.props as { solution: Solution };
---

<article class="rounded-xl border border-sda-border bg-sda-bg p-5 shadow-soft transition hover:-translate-y-0.5 hover:border-sda-brand/50">
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-base font-semibold leading-snug tracking-tight">
      <a
        href={solutionUrl(solution)}
        class="rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-sda-brand/60"
      >
        {solution.title}
      </a>
    </h3>
    <DifficultyBadge difficulty={solution.difficulty} />
  </div>
  <div class="mt-3 flex flex-wrap items-center gap-2">
    <a
      href={categoryUrl(solution.categorySlug)}
      class="rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-sda-brand/60"
    >
      <CategoryLabel label={solution.categoryLabel} />
    </a>
  </div>
  <div class="mt-4">
    <TagList tags={solution.tags} />
  </div>
</article>
