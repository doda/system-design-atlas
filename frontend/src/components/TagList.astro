---
const { tags } = Astro.props as { tags: string[] };
---

{tags?.length ? (
  <ul class="flex flex-wrap gap-2" aria-label="Tags">
    {tags.map((tag) => (
      <li>
        <span class="inline-flex items-center rounded-full bg-sda-bg-subtle px-2 py-0.5 text-xs text-sda-fg-muted ring-1 ring-inset ring-sda-border">
          {tag}
        </span>
      </li>
    ))}
  </ul>
) : null}

