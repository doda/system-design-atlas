---
import type { PipelineStage } from "../lib/solutions";
import { solutionUrl } from "../lib/solutions";

type Props = {
  slug: string;
  categorySlug: string;
  currentStage: PipelineStage;
  hasDraft: boolean;
  hasReviewed: boolean;
  hasFinal: boolean;
};

const { slug, categorySlug, currentStage, hasDraft, hasReviewed, hasFinal } = Astro.props;
const baseUrl = solutionUrl({ categorySlug, slug });
---

<div class="mb-6 flex flex-wrap gap-2 border-b border-sda-border">
  {hasDraft ? (
    <a
      href={`${baseUrl}?stage=draft`}
      class={`px-4 py-2 text-sm font-medium transition-colors ${
        currentStage === "draft"
          ? "border-b-2 border-sda-brand text-sda-brand"
          : "text-sda-fg-muted hover:text-sda-fg"
      }`}
      data-stage="draft"
    >
      Draft
    </a>
  ) : null}
  {hasReviewed ? (
    <a
      href={`${baseUrl}?stage=reviewed`}
      class={`px-4 py-2 text-sm font-medium transition-colors ${
        currentStage === "reviewed"
          ? "border-b-2 border-sda-brand text-sda-brand"
          : "text-sda-fg-muted hover:text-sda-fg"
      }`}
      data-stage="reviewed"
    >
      Reviewed
    </a>
  ) : null}
  {hasFinal ? (
    <a
      href={baseUrl}
      class={`px-4 py-2 text-sm font-medium transition-colors ${
        currentStage === "final"
          ? "border-b-2 border-sda-brand text-sda-brand"
          : "text-sda-fg-muted hover:text-sda-fg"
      }`}
      data-stage="final"
    >
      Final
    </a>
  ) : null}
</div>

<script>
  // Handle stage switching via query parameter
  (() => {
    const url = new URL(window.location.href);
    const stageParam = url.searchParams.get("stage");
    if (stageParam && ["draft", "reviewed", "final"].includes(stageParam)) {
      // Update active state based on query parameter
      const links = document.querySelectorAll("a[data-stage]");
      links.forEach((link) => {
        const linkStage = link.getAttribute("data-stage");
        if (linkStage === stageParam) {
          link.classList.add("border-b-2", "border-sda-brand", "text-sda-brand");
          link.classList.remove("text-sda-fg-muted");
        } else {
          link.classList.remove("border-b-2", "border-sda-brand", "text-sda-brand");
          link.classList.add("text-sda-fg-muted");
        }
      });
    }
  })();
</script>

