  subgraph Client["Clients"]
    C1["CLI / SDK"]
    C2["Admin Console"]
    W["Worker Agents"]
  end

  subgraph Edge["Edge"]
    GW["API Gateway\nAuthN/Z, routing, WAF"]
  end

  subgraph Control["Control Plane (Durable)"]
    JS["Job Service\nCRUD, idempotency, config"]
