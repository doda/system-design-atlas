  S->>S: baseline + score + top-N
  S->>T: publish trends.materialized
  S->>V: upsert KV (segment_id, window_id)
  Q->>R: GET cache
  alt cache hit
    R-->>Q: top-N + freshness
  else cache miss
    Q->>V: GET KV
    V-->>Q: top-N + freshness
    Q->>R: SET TTL 2-10s
  end
