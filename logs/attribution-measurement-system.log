    Gate["Privacy Gate\nThresholds + Buckets + Noise + Budget"]
    Report["Reporting API\nDashboards + Exports"]
  end

  SKAN --> GW
  Partner --> GW
  GW --> Ingest
  Ingest --> Bus
  Bus --> Verify
  Verify --> Raw
  Verify --> StreamAgg
  Raw --> BatchAgg
  StreamAgg --> OLAP
  BatchAgg --> OLAP
