    BUS --> STREAM[Streaming Features\nFlink]
    STREAM --> OFS

    BUS --> LAKE[(Data Lake\nIceberg/Delta)]
    LAKE --> TRAIN[Training + Backtesting]
    TRAIN --> REG[Model Registry]
    REG --> ART[(Artifact Store)]
