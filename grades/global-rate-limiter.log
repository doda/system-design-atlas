  subgraph EL["Edge Layer"]
    GW["API Gateway"]
    RL["Rate Limiter"]
    L1[("L1 Cache")]
  end

  subgraph RLAYER["Regional Layer"]
    RLS["Regional Service"]
    RKV[("Redis")]
  end

  subgraph CP["Control Plane"]
    CPS["Policy Service"]
    PDB[("Postgres")]
  end

  subgraph OBS["Observability"]
    MET["Metrics"]
    LOG["Logs"]
  end

  GW --> RL --> L1
  RL -->|miss| RLS --> RKV
  CPS --> PDB
  CPS -->|snapshots| RLS
  RL --> MET
  RLS --> LOG
```

